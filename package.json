{
  "name": "opencode-prompt-suggester",
  "version": "2.0.0",
  "description": "Intent-aware next-prompt suggestions for OpenCode V2",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burningportra/opencode-prompt-suggester.git"
  },
  "exports": {
    ".": "./src/server.ts",
    "./server": "./src/server.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "patches",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "demo.gif"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "node --experimental-strip-types --test src/domain/steering.test.ts src/domain/seed.test.ts src/infra/sdk.test.ts src/app/context.test.ts src/app/hidden.test.ts src/tui.test.ts"
  },
  "engines": {
    "opencode": ">=2.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "^22.13.9",
    "solid-js": "1.9.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "prompt-suggester",
    "ghost-text"
  ]
}
