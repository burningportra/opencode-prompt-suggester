@@ -0,0 +1,63 @@
+import { describe, expect, spyOn, test } from "bun:test"
+import type { ComposerPlaceholder, ComposerPlaceholderProps } from "@opencode/plugin/gui"
+import type { Item } from "@/runtime/plugin/host"
+import { selectComposerPlaceholder } from "./plugin-placeholder"
+
+const input = {} as ComposerPlaceholderProps
+
+const item = (plugin: string, value: ComposerPlaceholder): Item<ComposerPlaceholder> => ({
+  key: plugin,
+  plugin,
+  value,
+})
+
+describe("selectComposerPlaceholder", () => {
+  test("sorts by order and returns the first non-empty text", () => {
+    expect(
+      selectComposerPlaceholder(
+        [
+          item("slow", { id: "slow", order: 2, show: () => "slow" }),
+          item("fast", { id: "fast", order: 1, show: () => "fast" }),
+        ],
+        input,
+      ),
+    ).toBe("fast")
+  })
+
+  test("skips empty contributions", () => {
+    expect(
+      selectComposerPlaceholder(
+        [item("empty", { id: "empty", show: () => "" }), item("next", { id: "next", show: () => "next" })],
+        input,
+      ),
+    ).toBe("next")
+  })
+
+  test("logs a throwing contribution and continues", () => {
+    const error = spyOn(console, "error").mockImplementation(() => {})
+
+    try {
+      expect(
+        selectComposerPlaceholder(
+          [
+            item("broken", {
+              id: "broken",
+              show: () => {
+                throw new Error("boom")
+              },
+            }),
+            item("next", { id: "next", show: () => "next" }),
+          ],
+          input,
+        ),
+      ).toBe("next")
+      expect(error).toHaveBeenCalledWith("[plugin] broken", expect.any(Error))
+    } finally {
+      error.mockRestore()
+    }
+  })
+
+  test("returns undefined when every contribution is empty", () => {
+    expect(selectComposerPlaceholder([item("empty", { id: "empty", show: () => undefined })], input)).toBeUndefined()
+  })
+})
diff --git a/packages/app/src/session/composer/plugin-placeholder.ts b/packages/app/src/session/composer/plugin-placeholder.ts
new file mode 100644
index 0000000..bd9215f
--- /dev/null
+++ b/packages/app/src/session/composer/plugin-placeholder.ts
@@ -0,0 +1,17 @@
+import type { ComposerPlaceholder, ComposerPlaceholderProps } from "@opencode/plugin/gui"
+import type { Item } from "@/runtime/plugin/host"
+
+/** The first non-empty plugin placeholder, in contribution order. */
+export function selectComposerPlaceholder(
+  items: readonly Item<ComposerPlaceholder>[],
+  input: ComposerPlaceholderProps,
+) {
+  for (const item of items.toSorted((left, right) => (left.value.order ?? 0) - (right.value.order ?? 0))) {
+    try {
+      const text = item.value.show(input)
+      if (text) return text
+    } catch (error) {
+      console.error(`[plugin] ${item.plugin}`, error)
+    }
+  }
+}
